# Example environment variables for local development
# Copy to .env.dev and adjust values as needed.
# This file is safe to commit; .env.dev is ignored.

# Application
NODE_ENV=development
PORT=3000

# LocalStack / AWS emulation
DYNAMO_TABLES_DIR=src/infra/dynamo/tables
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_ENDPOINT=localstack:4566
DYNAMODB_TABLE_USERS=user
ENDPOINT_URL=localstack:4566
REGION=sa-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
