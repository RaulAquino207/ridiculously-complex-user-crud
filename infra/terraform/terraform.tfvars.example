# Terraform tfvars example for ridiculously-complex-user-crud
#
# How to use:
# 1) Copy this file to terraform.tfvars
#    cp infra/terraform/terraform.tfvars.example infra/terraform/terraform.tfvars
# 2) Edit the required values below (required: ssh_public_key_path, registry, image_name)
# 3) Choose registry auth: use_ecr = true (AWS ECR) OR false (Docker Hub/other)
# 4) Run Terraform from infra/terraform
#    terraform init
#    terraform apply
#
# Notes:
# - This template creates 2 EC2 instances: prod and test (see locals in main.tf).
# - Open ports: 22 (SSH) + 80 (prod) and 3001 (test).
# - ssh_public_key_path must be an ABSOLUTE path to your public key (.pub).

# ========================
# AWS
# ========================
region        = "sa-east-1"      # change if needed
aws_profile   = "raulaquino297"  # your AWS CLI profile (e.g., the one used in aws ec2 describe-instances)
name          = "rc-user-crud"    # base/prefix name for resources
instance_type = "t2.micro"        # EC2 instance type

# Absolute path to your SSH public key (e.g., id_ed25519.pub or id_rsa.pub)
# Tip: avoid ~; use the full path (/Users/<your-user>/...)
ssh_public_key_path = "/Users/<your-user>/.ssh/id_ed25519.pub"

# ========================
# Container image
# ========================
# Option A) AWS ECR (recommended if hosting on AWS)
use_ecr   = true
# Replace with your ECR registry: <ACCOUNT_ID>.dkr.ecr.<region>.amazonaws.com
registry   = "123456789012.dkr.ecr.sa-east-1.amazonaws.com"
# Repository/image name in ECR (without the registry)
image_name = "rc-user-crud"

# When use_ecr = true, you don't need username/password.
# The EC2 instance gets a role with ECR pull permissions.

# Option B) Docker Hub or other registry (uncomment and adjust if preferred)
# use_ecr           = false
# registry          = "docker.io"
# image_name        = "your-user/rc-user-crud"
# registry_username = "your-user"
# registry_password = "your-access-token-or-password"
